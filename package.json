{
  "name": "dynamic-island-windows",
  "version": "1.0.1",
  "description": "Notchy: viÃªn thuá»‘c tiá»‡n Ã­ch á»Ÿ Ä‘á»‰nh mÃ n hÃ¬nh cho Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prep-bin": "node scripts/prep-bin.js",
    "dist": "npm run prep-bin && electron-builder --win --publish never",
    "release": "npm run prep-bin && electron-builder --win --publish always",
    "test": "node --test test/",
    "test:ui": "node test/run-ui.js",
    "test:rust": "cd native && cargo test --release",
    "test:all": "npm test && npm run test:ui && npm run test:rust"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "productName": "Notchy",
  "author": "Na",
  "build": {
    "appId": "com.na.notchy",
    "productName": "Notchy",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "lib/**",
      "preload.js",
      "renderer/**",
      "assets/**",
      "scripts/*.ps1",
      "bin/**",
      "package.json",
      "settings-preload.js",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Notchy-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Notchy",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iamna2000",
        "repo": "notchy",
        "releaseType": "release"
      }
    ]
  }
}
